# Helfi.Space – Einstellungen für Docker
# Kopieren nach .env und anpassen. Alles andere (AD, SSO, E-Mail) in der Weboberfläche.

# Adresse, unter der Helfi.Space erreichbar ist (für Links in E-Mails und SSO).
# Für den Betrieb: hinter einem Reverse-Proxy mit HTTPS, z. B. https://helfi.firma.local
HELFI_BASE_URL=http://helfi.firma.local:8080

# Port auf dem Host
HELFI_HTTP_PORT=8080

# Programmversion: latest = immer die neueste. Zum Festhalten z. B. 1.0.0 eintragen.
HELFI_VERSION=latest

# Zeitzone
TZ=Europe/Berlin

# Besitzer der Dateien in ./data (Synology: ID des Benutzers/der Gruppe, z. B. 1026 / 100; nicht 0)
PUID=1000
PGID=1000

# Optional: eigener Schlüssel für gespeicherte Kennwörter (mind. 16 Zeichen).
# Leer = wird beim ersten Start erzeugt und in ./data/secret.key abgelegt (mitsichern!).
# Nur bei der Einrichtung festlegen – ein späterer Wechsel macht gespeicherte Kennwörter unlesbar.
HELFI_SECRET=

# Hinter einem Reverse-Proxy: dessen Adresse eintragen, damit die echte Client-IP ankommt
# (z. B. 10.0.10.5 oder 172.16.0.0/12 für einen Proxy-Container). Standard: nur loopback.
# HELFI_TRUST_PROXY=10.0.10.5

# Optional: Protokoll (debug | info | warn | error), Anhanggröße, Sitzungsdauer, Sicherungen
# HELFI_LOG_LEVEL=info
# HELFI_MAX_UPLOAD_MB=25
# HELFI_SESSION_HOURS=12
# HELFI_BACKUP_KEEP_DAYS=14

# Selten nötig:
# HELFI_SETUP_TOKEN=        eigener Einrichtungscode statt eines zufälligen
# HELFI_SECURE_COOKIES=true Cookies nur über HTTPS (Standard: an, wenn HELFI_BASE_URL mit https:// beginnt)
# HELFI_PORT nicht ändern – der Port im Container ist fest 8080 (Host-Port: HELFI_HTTP_PORT)
