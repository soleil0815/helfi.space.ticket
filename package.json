{
  "name": "helfi-space",
  "version": "1.0.0",
  "description": "Helfi.Space – schlankes Ticketsystem mit Active-Directory-Anbindung, SSO und E-Mail-Abruf",
  "license": "AGPL-3.0-or-later",
  "private": true,
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "HELFI_DATA_DIR=./data HELFI_BASE_URL=http://localhost:8080 node --watch src/server.js",
    "test": "node --test test/*.test.js",
    "test:integration": "node --test test/integration/*.test.js"
  },
  "dependencies": {
    "@simplewebauthn/server": "^14.1.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "html-to-text": "^10.0.1",
    "imapflow": "^2.10.0",
    "ldapts": "^9.2.0",
    "mailparser": "^3.14.1",
    "multer": "^2.5.0",
    "nodemailer": "^10.3.1",
    "openid-client": "^6.8.9",
    "qrcode": "^1.5.4",
    "sanitize-html": "^2.18.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/soleil0815/helfi.space.ticket"
  }
}
