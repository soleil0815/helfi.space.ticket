# Helfi.Space – settings for Docker
# Copy to .env and adjust. Everything else (AD, SSO, email) is configured in the web interface.

# Address where Helfi.Space is reachable (used for links in emails and for SSO).
# In production: behind a reverse proxy with HTTPS, e.g. https://helfi.firma.local
HELFI_BASE_URL=http://helfi.firma.local:8080

# Port on the host
HELFI_HTTP_PORT=8080

# Program version: latest = always the newest. To pin a version, enter e.g. 1.0.2.
HELFI_VERSION=latest

# Time zone
TZ=Europe/Berlin

# Owner of the files in ./data (Synology: ID of your user/group, e.g. 1026 / 100; not 0)
PUID=1000
PGID=1000

# Optional: your own key for stored passwords (at least 16 characters).
# Empty = generated on first start and stored in ./data/secret.key (include it in backups!).
# Only set this during setup – changing it later makes stored passwords unreadable.
HELFI_SECRET=

# Behind a reverse proxy: enter its address so the real client IP is used
# (e.g. 10.0.10.5, or 172.16.0.0/12 for a proxy container). Default: loopback only.
# HELFI_TRUST_PROXY=10.0.10.5

# Optional: log level (debug | info | warn | error), attachment size,
# sign-out after this many hours without activity (default; can be changed under Administration → Security)
# HELFI_LOG_LEVEL=info
# HELFI_MAX_UPLOAD_MB=25
# HELFI_SESSION_HOURS=12

# Rarely needed:
# Your own setup code instead of a random one:
# HELFI_SETUP_TOKEN=
# Cookies over HTTPS only (default: on if HELFI_BASE_URL starts with https://):
# HELFI_SECURE_COOKIES=true
# Import from a ticket system that is only reachable via 127.0.0.1 on this machine
# (local and link-local addresses are blocked for the import by default):
# HELFI_IMPORT_ALLOW_LOCAL=1
# Running a modified version? AGPL-3.0 requires offering your users its source code:
# link shown as "Source code" in the program (default: the official repository)
# HELFI_SOURCE_URL=https://git.firma.example/it/helfi
# Do not change HELFI_PORT – the port inside the container is always 8080 (host port: HELFI_HTTP_PORT)
